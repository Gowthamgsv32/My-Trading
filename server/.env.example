# Angel One SmartAPI credentials for the live market feed.
# Copy this file to `.env` (which is git-ignored) and fill in your values.
# Leave them blank to run the backend in SIMULATOR mode (no real data).
#
# Get these from https://smartapi.angelbroking.com after enabling API access:
#   1. Create an app to obtain your API key.
#   2. SMARTAPI_CLIENT_CODE is your Angel One login/client ID.
#   3. SMARTAPI_PASSWORD is your trading/login PIN (MPIN).
#   4. SMARTAPI_TOTP_SECRET is the base32 secret shown when you enable TOTP
#      (the same secret your authenticator app uses) — NOT a 6-digit code.

SMARTAPI_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PASSWORD=
SMARTAPI_TOTP_SECRET=

# Optional: override the default watchlist (comma-separated NSE symbols).
# WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# Optional: how often (ms) to poll the Market Data REST quote API as a fallback
# for symbols the websocket hasn't ticked recently (e.g. when the market is
# closed). Default 15000. Set 0 to disable and rely on the websocket only.
# MARKETDATA_REFRESH_MS=15000

# Optional: port the relay listens on (default 8080).
# PORT=8080
