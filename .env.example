# Frontend configuration (Vite). Copy to `.env` for local overrides.

# URL of the backend WebSocket relay (see server/).
# Local dev default is ws://localhost:8080.
# For the GitHub Pages build (served over https) this MUST be a wss:// URL,
# e.g. wss://your-relay.onrender.com, or the browser will block it.
VITE_FEED_WS_URL=ws://localhost:8080
